# Put the real values in Replit's Secrets tab, not in a file.

# Claude, for recipe extraction (server/lib/structureRecipe.ts).
ANTHROPIC_API_KEY=sk-ant-...

# Postgres. Required — the library and the extraction cache both live here,
# and server/db.ts throws on the first query without it.
DATABASE_URL=postgresql://user:password@host:5432/database

# Google sign-in. All three must be set or sign-in reports itself
# unconfigured — see docs/google-oauth.md. PUBLIC_BASE_URL is scheme and host
# only, no trailing slash: the redirect URI is built from it and has to match
# what is registered in the Google console exactly.
PUBLIC_BASE_URL=https://your-app.replit.app
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
