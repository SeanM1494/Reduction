# Restored after the Sep 8 workspace migration stripped the run and deployment
# commands entirely ("Could not find run command" on publish). The serving
# model is deliberately self-contained: in production the api-server serves
# the built frontend from one port (see artifacts/api-server/src/app.ts), so
# deployment needs no platform-side routing that lives outside this file.

modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

# The Run button: api on 3001, web on 5000, /api proxied (scripts/dev.sh).
run = "bash scripts/dev.sh"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 20274
externalPort = 5000
exposeLocalhost = true

[[ports]]
localPort = 22216
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
# Build the frontend first (BASE_PATH and a dummy PORT satisfy its vite
# config's hard requirement — PORT is unused at build time), then the api.
build = ["sh", "-c", "pnpm install --frozen-lockfile && BASE_PATH=/ PORT=5000 pnpm --filter ./artifacts/reduction run build && pnpm --filter @workspace/api-server run build"]
# One process, one port: Replit injects PORT; NODE_ENV=production turns on
# static serving + the SPA fallback in app.ts.
run = ["sh", "-c", "NODE_ENV=production pnpm --filter @workspace/api-server run start"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
# 120s, the pre-migration value. The migration cut it to 20s, which is not
# enough for `pnpm install --frozen-lockfile` to finish linking a workspace
# package on a cold merge — the mobile app then crashed on load because
# node_modules/@workspace/recipe-model was never created. (metro.config.js
# now aliases that package so the app boots either way; this is so the
# install actually completes for everything else.)
timeoutMs = 120000

[nix]
channel = "stable-25_05"
