# Put the real values in Replit's Secrets tab, not in a file.

# Claude, for recipe extraction (server/lib/structureRecipe.ts).
ANTHROPIC_API_KEY=sk-ant-...

# Postgres. Required — the library and the extraction cache both live here,
# and server/db.ts throws on the first query without it.
DATABASE_URL=postgresql://user:password@host:5432/database
