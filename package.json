{
  "name": "reduction",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "NODE_ENV=production vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "check": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "db:push": "drizzle-kit push",
    "db:backfill-url-key": "tsx server/scripts/backfillUrlKey.ts",
    "test:db": "bash scripts/test-db.sh run",
    "test:db:stop": "bash scripts/test-db.sh stop",
    "test:db:reset": "bash scripts/test-db.sh reset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@types/pg": "^8.21.0",
    "cheerio": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "tsx": {
      "esbuild": "^0.28.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.1"
    }
  },
  "packageManager": "npm@11.19.0"
}
