auto-install-peers=false
strict-peer-dependencies=false

# SECURITY: supply-chain defense — a package version must have been published
# for at least 1 day (1440 minutes) before npm will install it. Malicious npm
# releases are typically caught and unpublished within hours, so the delay is a
# cheap, strong buffer. Do not lower or remove this.
#
# Needs npm >= 11.6 (see `packageManager` in package.json); older npm silently
# ignores the key, which is why the version floor matters. Carried over from the
# pnpm-era `pnpm-workspace.yaml`, which npm never read.
min-release-age=1440
